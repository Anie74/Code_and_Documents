## 1. ReBooleanCapitalizationRule

Détecte les booléens et `nil` mal capitalisés (`True`, `False`, `Nil`).

### Règle

```smalltalk
ReAbstractRule subclass: #ReBooleanCapitalizationRule
    instanceVariableNames: ''
    classVariableNames: ''
    package: 'Renraku'

"===== INSTANCE SIDE ====="

"Protocole: checking"
ReBooleanCapitalizationRule >> checkMethod: aMethod

    | critiques sourceCode |
    critiques := OrderedCollection new.
    sourceCode := aMethod sourceCode.

    self detectBoolean: 'True' -> 'true' in: sourceCode for: aMethod critiques: critiques.
    self detectBoolean: 'False' -> 'false' in: sourceCode for: aMethod critiques: critiques.
    self detectBoolean: 'Nil' -> 'nil' in: sourceCode for: aMethod critiques: critiques.
  

"Protocole: private"
ReBooleanCapitalizationRule >> detectBoolean: wrongForm shouldBe: correctForm in: sourceCode for: aMethod addTo: critiques
    "Détecte une forme incorrecte et crée une critique avec message personnalisé"

    (sourceCode includesSubstring: wrongForm) ifTrue: [
        critiques add: (ReTrivialCritique new
            rule: self;
            entity: aMethod;
            tinyHint: wrongForm, ' doit être écrit ', correctForm, ' (minuscules)';
            yourself) ]

"Protocole: accessing"
ReBooleanCapitalizationRule >> group
    ^ 'Erreurs débutant'

ReBooleanCapitalizationRule >> name
    ^ 'Booléens mal capitalisés'

ReBooleanCapitalizationRule >> rationale
    ^ 'En Pharo, les booléens et nil doivent être écrits en minuscules: true, false, nil'

ReBooleanCapitalizationRule >> severity
    ^ #error

"===== CLASS SIDE ====="

"Protocole: accessing"
ReBooleanCapitalizationRule class >> uniqueIdentifierName
    ^ 'BooleanCapitalization'
```

### Tests

```smalltalk
TestCase subclass: #ReBooleanCapitalizationRuleTest
    instanceVariableNames: 'rule testClass'
    classVariableNames: ''
    package: 'Renraku-Tests'

ReBooleanCapitalizationRuleTest >> setUp
    super setUp.
    rule := ReBooleanCapitalizationRule new.
    testClass := Object subclass: #TestBooleanClass
        instanceVariableNames: ''
        classVariableNames: ''
        package: 'Renraku-Tests-Temp'

ReBooleanCapitalizationRuleTest >> tearDown
    testClass removeFromSystem.
    super tearDown

ReBooleanCapitalizationRuleTest >> testDetectTrue
    | method critiques |
    testClass compile: 'testMethod
        ^ True'.
    method := testClass >> #testMethod.
    critiques := rule checkMethod: method.
    self assert: critiques size equals: 1.
    self assert: (critiques first tinyHint includesSubstring: 'true')

ReBooleanCapitalizationRuleTest >> testDetectFalse
    | method critiques |
    testClass compile: 'testMethod
        ^ False'.
    method := testClass >> #testMethod.
    critiques := rule checkMethod: method.
    self assert: critiques size equals: 1.
    self assert: (critiques first tinyHint includesSubstring: 'false')

ReBooleanCapitalizationRuleTest >> testDetectNil
    | method critiques |
    testClass compile: 'testMethod
        ^ Nil'.
    method := testClass >> #testMethod.
    critiques := rule checkMethod: method.
    self assert: critiques size equals: 1.
    self assert: (critiques first tinyHint includesSubstring: 'nil')

ReBooleanCapitalizationRuleTest >> testDetectMultiple
    | method critiques |
    testClass compile: 'testMethod
        True ifTrue: [ ^ False ].
        ^ Nil'.
    method := testClass >> #testMethod.
    critiques := rule checkMethod: method.
    self assert: critiques size equals: 3

ReBooleanCapitalizationRuleTest >> testNoFalsePositives
    | method critiques |
    testClass compile: 'testMethod
        true ifTrue: [ ^ false ].
        ^ nil'.
    method := testClass >> #testMethod.
    critiques := rule checkMethod: method.
    self assert: critiques isEmpty
```

